@charset "utf-8";

.markItUp * { margin: 0px; padding: 0px; outline: none; }

.markItUp a:link, .markItUp a:visited { color: rgb(0, 0, 0); text-decoration: none; }

.markItUp { margin: 5px 0px; border: 0px solid rgb(245, 245, 245); }

.markItUpContainer { border: 1px solid rgb(185, 185, 185); padding: 5px 5px 2px; font: 11px Verdana, Arial, Helvetica, sans-serif; }

.markItUpEditor { font: 12px / 18px Consolas, "Lucida Console", "Andale Mono", "Bitstream Vera Sans Mono", "Courier New", Courier; padding: 5px; border: 1px solid rgb(185, 185, 185); height: 320px; clear: both; overflow: auto; }

.markItUpPreviewFrame { overflow: auto; background-color: rgb(255, 255, 255); border: 1px solid rgb(60, 118, 157); width: 99.9%; height: 300px; margin: 5px 0px; }

.markItUpFooter { width: 100%; cursor: n-resize; }

.markItUpResizeHandle { overflow: hidden; width: 22px; height: 5px; margin-left: auto; margin-right: auto; background-image: url("images/handle.png"); cursor: n-resize; }

.markItUpHeader ul li { list-style: none; float: left; position: relative; margin: 0px; padding: 0px; }

.markItUpHeader ul li ul { display: none; }

.markItUpHeader ul li:hover > ul { display: block; }

.markItUpHeader ul .markItUpDropMenu { background: url("images/menu.png") 115% 50% no-repeat transparent; margin-right: 5px; }

.markItUpHeader ul .markItUpDropMenu li { margin-right: 0px; }

.markItUpHeader ul .markItUpSeparator { margin: 0px 10px; width: 1px; height: 16px; overflow: hidden; background-color: rgb(204, 204, 204); }

.markItUpHeader ul ul .markItUpSeparator { width: auto; height: 1px; margin: 0px; }

.markItUpHeader ul ul { display: none; position: absolute; top: 18px; left: 0px; background: rgb(255, 255, 255); border: 1px solid rgb(185, 185, 185); height: inherit; }

.markItUpHeader ul ul li { float: none; border-bottom: 1px solid rgb(185, 185, 185); }

.markItUpHeader ul ul .markItUpDropMenu { background: url("images/submenu.png") 100% 50% no-repeat rgb(255, 255, 255); }

.markItUpHeader ul ul ul { position: absolute; top: -1px; left: 150px; }

.markItUpHeader ul ul ul li { float: none; }

.markItUpHeader ul a { display: block; width: 16px; height: 16px; text-indent: -10000px; background-repeat: no-repeat; padding: 3px; margin: 0px; }

.markItUpHeader ul ul a { display: block; text-indent: 0px; width: 120px; padding: 5px 5px 5px 25px; background-position: 2px 50%; }

.markItUpHeader ul ul a:hover { color: rgb(255, 255, 255); background-color: rgb(60, 118, 157); }

.html .markItUpEditor { background-image: url("images/bg-editor-html.png"); }

.markdown .markItUpEditor { background-image: url("images/bg-editor-none.png"); }

.textile .markItUpEditor { background-image: url("images/bg-editor-textile.png"); }

.bbcode .markItUpEditor { background-image: url("images/bg-editor-bbcode.png"); }

.wiki .markItUpEditor, .dotclear .markItUpEditor { background-image: url("images/bg-editor-wiki.png"); }
