# Copy to .env.storage (ignored by Git). Do not put passwords in this template.
# No remote database or R2 bucket is created by copying this file.
SUPABASE_URL=
# Server-side API keys, generated by the local setup script or a hosted project.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection URI for applying migrations; use the session/direct endpoint.
SUPABASE_DB_URL=
# R2 settings are reserved for the later archive integration.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
